# Copy this file to .env.local and fill in the values you have. Every
# feature that depends on a missing key falls back to MOCK_AI_PROVIDERS
# behavior — the app is designed to run fully with only the Supabase block
# filled in. Never commit .env.local.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (required) — from your project's Settings > API, or from
# `supabase start` output when running the local stack.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe (optional — Phase 4). Leave empty to keep billing pages in
# "coming soon" mode. Price IDs are read server-side only; never trust a
# price sent from the client.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=

# ---------------------------------------------------------------------------
# AI providers (optional — Phase 3+). Leave empty to stay in MOCK mode.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# VIDEO_PROVIDER: mock | kling | runway | luma
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=

# VOICE_PROVIDER: mock | elevenlabs
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Email (optional — Phase 5)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Jobs / queue (optional — Phase 2+). Needed once background rendering jobs
# are wired up (Inngest/Trigger.dev/BullMQ — see docs/architecture.md).
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Mode & access control
# ---------------------------------------------------------------------------
# When unset or anything other than "false", every AI provider call is
# simulated (fake delays, placeholder assets) so the full product can be
# tested without spending API credits.
MOCK_AI_PROVIDERS=true

# Comma-separated list of emails granted access to /admin (Phase 5).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Analytics (optional — Phase 5)
# ---------------------------------------------------------------------------
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Google OAuth (optional). Also requires enabling the provider in either
# your hosted Supabase project's Auth settings, or in supabase/config.toml
# for the local stack.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
